# App
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security (SECRET_KEY is required)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_SECRET_KEY=
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limiting (per client IP, "<count>/<second|minute|hour|day>", separated by ";")
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute;20/hour
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_VERIFY_OTP=10/minute
RATE_LIMIT_SEND_OTP=3/minute;10/hour
RATE_LIMIT_REFRESH=30/minute

# Google OAuth state cookie
OAUTH_STATE_COOKIE_NAME=google_oauth_state
OAUTH_STATE_MAX_AGE_SECONDS=600

# Database (Prisma needs the plain postgresql:// scheme)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitchbooking
TEST_DATABASE_URL=

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=PitchBooking

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
