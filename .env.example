# Copy to `.env` and fill in the values:  cp .env.example .env
# `.env` is git-ignored: never commit real secrets.

# ---------- App ----------
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---------- Security ----------
# REQUIRED. Generate with: openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- OTP ----------
# Optional: falls back to SECRET_KEY when empty
OTP_SECRET_KEY=
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Rate limiting (per client IP, "<count>/<second|minute|hour|day>", separated by ";") ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute;20/hour
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_VERIFY_OTP=10/minute
RATE_LIMIT_SEND_OTP=3/minute;10/hour
RATE_LIMIT_REFRESH=30/minute

# ---------- Database (PostgreSQL, plain postgresql:// scheme) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitchbooking
# Tests use this database (default: same server, database name pitchbooking_test)
TEST_DATABASE_URL=
# TEST_DB_NAME=pitchbooking_test

# ---------- SMTP / Email (optional: emails are skipped when not set) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=PitchBooking

# ---------- Google OAuth2 (optional) ----------
OAUTH_STATE_COOKIE_NAME=google_oauth_state
OAUTH_STATE_MAX_AGE_SECONDS=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
