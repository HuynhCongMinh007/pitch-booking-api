{
  "name": "pitch-booking-api",
  "version": "1.0.0",
  "description": "PitchBooking API (NestJS + Clean Architecture + DDD + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=e2e --testPathIgnorePatterns=infrastructure",
    "test:db": "ts-node scripts/create-test-db.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.3.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "supertest": "7.3.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "argon2": false,
    "core-js": false
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": true
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
